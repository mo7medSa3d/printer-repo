# Copy this file to .env for local Docker Compose development only.
# In production, inject these values from the host's secret manager/environment.
# Compose exposes the sensitive values to services as /run/secrets/* files;
# the secrets are not placed in container environment variables.

POSTGRES_DB=odoo_print
POSTGRES_USER=odoo_print
POSTGRES_PASSWORD=replace-with-a-long-random-password

GATEWAY_JWT_SECRET=replace-with-at-least-32-random-characters
TRUST_PROXY_SECRET=replace-with-another-at-least-32-random-secret

MANAGER_USERNAME=admin
# Prefer MANAGER_PASSWORD_HASH in production. Set the full salt:64-hex hash.
MANAGER_PASSWORD_HASH=
MANAGER_PASSWORD=

# Supported tenancy: one Odoo database per Gateway installation.
ODOO_DATABASE_NAME=odoo_print

# Caddy is the only public entry point in the reference stack.
GATEWAY_DOMAIN=print.example.com
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443
TRUST_PROXY=1

STALE_AGENT_THRESHOLD_SECONDS=90

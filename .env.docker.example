# Copy this file to .env before starting the stack.
# Never commit the real .env file.

POSTGRES_DB=odoo_print
POSTGRES_USER=odoo_print
POSTGRES_PASSWORD=replace-with-a-long-random-password

GATEWAY_JWT_SECRET=replace-with-at-least-32-random-characters

MANAGER_USERNAME=admin
# Prefer MANAGER_PASSWORD_HASH in production. If both are set, use the hash.
# MANAGER_PASSWORD_HASH=salt:derived-hex
MANAGER_PASSWORD=

# Public host port for the gateway.
GATEWAY_PORT=3000

# The gateway takes the client IP from X-Forwarded-For when this is 1
# (per-IP rate limiting + WS caps). Leave it at the default (1): the
# bundled Caddyfile overwrites X-Forwarded-For with the real client
# address. Set TRUST_PROXY=0 only if the gateway is reached directly
# (no proxy) — then IP-scoped rate limiting is disabled by design.
TRUST_PROXY=

STALE_AGENT_THRESHOLD_SECONDS=90

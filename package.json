{
  "name": "odoo-print-gateway",
  "version": "1.0.0",
  "description": "Odoo Local Print Agent \u2014 cloud print gateway (Next.js + PostgreSQL + Drizzle), Windows Go agent, and Tauri desktop manager",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "dev:next": "next dev",
    "start": "NODE_ENV=production tsx server.ts",
    "start:next": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "desktop:vite:build": "vite build --config vite.desktop.config.mts",
    "desktop:build": "npm run desktop:vite:build && pwsh -File scripts/build-windows-installer.ps1",
    "desktop:dev": "vite --config vite.desktop.config.mts",
    "test:unit": "vitest run --config vitest.config.mts --exclude tests/architecture-pg.test.ts --exclude tests/routing-availability.test.ts --exclude tests/print-idempotency.test.ts --exclude tests/e2e-job-flow.test.ts --exclude tests/ws-claim-delivery.test.ts --exclude tests/job-status-postgres-concurrency.test.ts --exclude tests/auth-rate-limit.test.ts --exclude tests/heartbeat-enabled.test.ts --exclude tests/health.test.ts --exclude tests/agent-registration.test.ts --exclude tests/migration-upgrade.integration.test.ts --exclude tests/multi-instance-gateway.test.ts",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "vitest run --config vitest.integration.config.mts --run tests/e2e-job-flow.test.ts",
    "build": "next build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.41.0",
    "nanoid": "^6.0.1",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.6.0",
    "ws": "8.21.3",
    "zod": "^4.6.1",
    "tsx": "^4.23.13",
    "drizzle-kit": "0.31.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.15",
    "@types/pg": "8.18.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.0.0",
    "eslint-config-next": "16.3.4",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "tailwindcss": "4.3.3",
    "vitest": "^4.1.11",
    "typescript": "^5.7.2",
    "vite": "^8.2.2"
  },
  "overrides": {
    "esbuild": "0.28.2"
  }
}

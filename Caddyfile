{$GATEWAY_DOMAIN} {
    encode gzip zstd

    # The Gateway trusts forwarded client identity only after verifying the
    # private proxy token. Caddy overwrites all client-controlled forwarding
    # headers before forwarding the request.
    header_up X-Gateway-Proxy-Token {$TRUST_PROXY_SECRET}
    header_up X-Forwarded-For {http.request.remote.host}
    header_up -X-Real-Ip

    request_body {
        max_size 8MiB
    }

    reverse_proxy gateway:3000
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Odoo Print Manager",
  "version": "1.0.0",
  "identifier": "com.odoo.printmanager",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run desktop:vite:build",
    "frontendDist": "../dist-desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Odoo Print Manager",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "../agent/OdooPrintAgent.exe": "resources/OdooPrintAgent.exe",
      "../agent/odoo-agent-cli.exe": "resources/odoo-agent-cli.exe"
    },
    "windows": {
      "nsis": {
        "template": "nsis",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}

# ─── Odoo Print Gateway — environment ────────────────────────────────────────
# Copy to `.env` for local development. In production, inject these via your
# process manager / secrets store — never commit a real `.env`.

DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# HMAC secret for manager session JWTs. REQUIRED in production, >= 32 chars.
# Generate: openssl rand -hex 32
GATEWAY_JWT_SECRET=changeme-to-at-least-32-chars-random-string

# Manager dashboard credentials. Prefer the scrypt hash in production so the
# plaintext password never lives on disk. Do not deploy with a placeholder.
# Generate: node -e "const crypto=require('crypto');const s=crypto.randomBytes(8).toString('hex');console.log(s+':'+crypto.scryptSync(process.argv[1],s,32).toString('hex'))" yourpass
MANAGER_USERNAME=admin
MANAGER_PASSWORD=
# MANAGER_PASSWORD_HASH=abc123:deadbeef...

# ─── Public TLS endpoint ─────────────────────────────────────────────────────
# Production compose exposes only Caddy on 80/443. Point this DNS name at the
# server so Caddy can obtain and renew a trusted certificate automatically.
GATEWAY_DOMAIN=print.example.com
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# Internal gateway listener; public traffic reaches it through Caddy TLS.
PORT=3000
HOSTNAME=0.0.0.0
NODE_ENV=production
# Per-IP rate limiting reads X-Forwarded-For when this is 1. Only keep it at
# 1 when EVERY path to the gateway goes through a trusted proxy that
# OVERWRITES X-Forwarded-For with the real client address (e.g. Caddy:
# `header_up X-Forwarded-For {http.request.remote.host}` +
# `header_up -X-Real-Ip`). Behind a proxy that merely appends, clients can
# spoof their IP and bypass all IP-scoped limits. Set 0 for direct access
# (IP rate limiting is then disabled by design).
TRUST_PROXY=1

# Agent freshness policy for job routing (10..3600 seconds; default 90).
STALE_AGENT_THRESHOLD_SECONDS=90

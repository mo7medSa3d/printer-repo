server:
  url: "https://your-odoo-server.com"

agent:
  id: ""
  secret: ""
  name: "Main Office Agent"

printers:
  - id: "printer_kitchen"
    name: "Kitchen Printer"
    type: "network"
    endpoint: "192.168.1.50:9100"
    protocol: "escpos"
  
  # NOTE: type "usb" validates but the Windows spooler backend is not wired
  # yet — printer.New() rejects USB printers with an explicit error (see
  # PRINTERS.md / factory.go). Prefer network (RAW TCP 9100) printers today.
  - id: "printer_receipt"
    name: "Front Desk Printer"
    type: "network"
    endpoint: "192.168.1.51:9100"
    protocol: "raw"

server:
  # Production gateways must use HTTPS. Plain HTTP requires the explicit
  # development-only environment opt-in described in the agent documentation.
  url: "https://your-print-gateway.example.com"

agent:
  id: ""
  secret: ""
  name: "Main Office Agent"
  # Safe default: false prevents silent duplicate physical output after a crash.
  # Set true only when the business accepts at-least-once reprinting.
  reprint_after_crash: false
  # Optional deterministic Windows PDF helper command, e.g. SumatraPDF.
  # pdf_print_command: ["C:\\Program Files\\SumatraPDF\\SumatraPDF.exe", "-print-to", "{printer}", "{file}"]

printers:
  - id: "printer_kitchen"
    name: "Kitchen Printer"
    type: "network"
    endpoint: "192.168.1.50:9100"
    protocol: "escpos"
  
  # USB printers can be represented through the Windows spooler backend when a
  # local Windows queue is available. Direct raw USB is intentionally not used
  # as a network transport.
  - id: "printer_receipt"
    name: "Front Desk Printer"
    type: "network"
    endpoint: "192.168.1.51:9100"
    protocol: "raw"

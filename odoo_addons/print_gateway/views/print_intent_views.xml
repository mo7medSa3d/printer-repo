<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_intent_list" model="ir.ui.view">
        <field name="name">print_gateway.intent.list</field>
        <field name="model">print_gateway.intent</field>
        <field name="arch" type="xml">
            <list string="Automated Print Intents" create="0" edit="0" delete="0">
                <field name="create_date" string="Captured At"/>
                <field name="company_id" optional="show"/>
                <field name="policy_id"/>
                <field name="event_type"/>
                <field name="res_model" string="Source Model"/>
                <field name="res_id" string="Source ID"/>
                <field name="intent_key" optional="hide"/>
                <field name="status" widget="badge"
                       decoration-info="status == 'pending'"
                       decoration-warning="status == 'claimed'"
                       decoration-success="status in ('dispatched', 'skipped')"
                       decoration-danger="status == 'failed'"/>
                <field name="attempts" string="Attempts"/>
                <field name="max_attempts" optional="hide"/>
                <field name="next_retry_at" optional="hide"/>
                <field name="print_job_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_print_gateway_intent_form" model="ir.ui.view">
        <field name="name">print_gateway.intent.form</field>
        <field name="model">print_gateway.intent</field>
        <field name="arch" type="xml">
            <form string="Automated Print Intent" create="0" delete="0" class="o_pg_view o_pg_form">
                <header>
                    <button name="action_rearm_intent" type="object" string="Re-arm for Dispatch" class="btn-warning"
                            confirm="Re-arming re-enqueues this failed print intent for immediate dispatch. If the previous attempt produced any output, a duplicate may print. Confirm you have verified the physical result."
                            invisible="status != 'failed'" groups="base.group_system"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,claimed,dispatched,failed,skipped"
                           decoration-danger="status == 'failed'" decoration-warning="status == 'claimed'"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="status != 'failed'">
                        <b>Routing failed after all automatic attempts.</b>
                        Check the error below, fix its cause (binding, printer or Gateway), then use
                        <i>Re-arm for Dispatch</i>. Re-arm creates no duplicate intent: it reuses this
                        durable record and its unique intent key.
                    </div>
                    <div class="alert alert-info" role="alert" invisible="status != 'pending'">
                        Waiting for the source business transaction to commit; dispatch happens only
                        afterwards.
                    </div>
                    <group>
                        <group string="Source Event">
                            <field name="company_id" readonly="1"/>
                            <field name="policy_id" readonly="1"/>
                            <field name="event_type" readonly="1"/>
                            <field name="res_model" readonly="1"/>
                            <field name="res_id" readonly="1"/>
                            <field name="intent_key" readonly="1"/>
                        </group>
                        <group string="Dispatch Progress">
                            <field name="attempts" readonly="1"/>
                            <field name="max_attempts" readonly="1"/>
                            <field name="next_retry_at" readonly="1"/>
                            <field name="claimed_at" readonly="1"/>
                            <field name="print_job_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Last Error" invisible="not last_error">
                        <field name="last_error" readonly="1" nolabel="1" class="o_pg_mono text-danger"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_print_gateway_intent_search" model="ir.ui.view">
        <field name="name">print_gateway.intent.search</field>
        <field name="model">print_gateway.intent</field>
        <field name="arch" type="xml">
            <search string="Search Print Intents">
                <field name="intent_key"/>
                <field name="policy_id"/>
                <field name="res_model"/>
                <field name="res_id"/>
                <filter name="filter_failed_intents" string="Failed (needs operator)" domain="[('status', '=', 'failed')]"/>
                <filter name="filter_inflight_intents" string="Pending / Claimed" domain="[('status', 'in', ['pending', 'claimed'])]"/>
                <filter name="filter_dispatched_intents" string="Dispatched" domain="[('status', '=', 'dispatched')]"/>
                <separator/>
                <group>
                    <filter name="group_intent_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_intent_policy" string="Policy" context="{'group_by': 'policy_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_print_gateway_intents" model="ir.actions.act_window">
        <field name="name">Automated Print Intents</field>
        <field name="res_model">print_gateway.intent</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_print_gateway_intent_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No automated print intents captured yet</p>
            <p>Intents are created durably inside business transactions (validated pickings,
               posted invoices, paid POS orders) and dispatched only after the transaction commits.</p>
        </field>
    </record>
</odoo>

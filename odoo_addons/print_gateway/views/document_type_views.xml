<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_document_type_form" model="ir.ui.view">
        <field name="name">print_gateway.document_type.form</field>
        <field name="model">print_gateway.document_type</field>
        <field name="arch" type="xml">
            <form string="Document Type" class="o_pg_view o_pg_form">
                <sheet>
                    <div class="o_pg_record_header">
                        <div class="o_pg_record_icon"><i class="fa fa-file-text-o" role="img" aria-label="Document Type"/></div>
                        <div>
                            <h1><field name="name" placeholder="Invoice, Receipt, Delivery"/></h1>
                            <div class="text-muted">Logical document type used for print routing</div>
                        </div>
                        <div class="ms-auto"><field name="enabled" widget="boolean_toggle"/></div>
                    </div>
                    <group string="Configuration">
                        <field name="branch_id" options="{'no_create': True}"/>
                        <field name="description" placeholder="Optional description"/>
                    </group>
                    <notebook>
                        <page string="Advanced" name="advanced">
                            <group string="Routing Metadata"><field name="payload_hint" placeholder="Optional operator hint"/></group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_print_gateway_document_type_tree" model="ir.ui.view">
        <field name="name">print_gateway.document_type.list</field>
        <field name="model">print_gateway.document_type</field>
        <field name="arch" type="xml">
            <list string="Document Types" class="o_pg_view o_pg_list" decoration-success="enabled" decoration-muted="not enabled">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_print_gateway_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">print_gateway.document_type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

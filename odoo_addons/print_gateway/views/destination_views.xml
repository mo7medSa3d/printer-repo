<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_destination_form" model="ir.ui.view">
        <field name="name">print_gateway.destination.form</field>
        <field name="model">print_gateway.destination</field>
        <field name="arch" type="xml">
            <form string="Destination" class="o_pg_view o_pg_form">
                <sheet>
                    <div class="o_pg_record_header">
                        <div class="o_pg_record_icon"><i class="fa fa-map-marker" role="img" aria-label="Destination"/></div>
                        <div>
                            <h1><field name="name"/></h1>
                            <div class="text-muted">Business print destination</div>
                        </div>
                        <div class="ms-auto"><field name="enabled" widget="boolean_toggle"/></div>
                    </div>
                    <group string="Configuration">
                        <field name="branch_id" options="{'no_create': True}"/>
                        <field name="destination_type"/>
                        <field name="zone" placeholder="Optional location label"/>
                    </group>
                    <group string="Notes">
                        <field name="description" placeholder="Optional notes for operators"/>
                    </group>
                    <notebook>
                        <page string="Printer Bindings"><field name="binding_ids"/></page>
                        <page string="Technical" name="technical">
                            <group><field name="gateway_destination_id" readonly="1" class="o_pg_mono"/></group>
                        </page>
                    </notebook>
                    <div class="alert alert-info" role="alert">
                        A destination is a business-facing routing point such as POS, reception, warehouse, or office.
                        Physical printer and agent details are selected when you configure a binding.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_print_gateway_destination_tree" model="ir.ui.view">
        <field name="name">print_gateway.destination.list</field>
        <field name="model">print_gateway.destination</field>
        <field name="arch" type="xml">
            <list string="Destinations" class="o_pg_view o_pg_list" decoration-success="enabled" decoration-muted="not enabled">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="destination_type"/>
                <field name="zone" optional="show"/>
                <field name="enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_print_gateway_destination" model="ir.actions.act_window">
        <field name="name">Destinations</field>
        <field name="res_model">print_gateway.destination</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_destination_form" model="ir.ui.view">
        <field name="name">print_gateway.destination.form</field>
        <field name="model">print_gateway.destination</field>
        <field name="arch" type="xml">
            <form string="Destination">
                <sheet>
                    <group string="Identity">
                        <field name="name" placeholder="e.g., POS Receipt"/>
                        <field name="zone" placeholder="e.g., Counter 1"/>
                        <field name="branch_id"/>
                        <field name="destination_type"/>
                        <field name="enabled" widget="boolean_toggle"/>
                    </group>
                    <group string="Gateway">
                        <field name="gateway_destination_id" help="Destination identifier as known to the Gateway, e.g. dest_pos_cairo."/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <group string="Printer Bindings">
                        <field name="binding_ids"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_print_gateway_destination_tree" model="ir.ui.view">
        <field name="name">print_gateway.destination.tree</field>
        <field name="model">print_gateway.destination</field>
        <field name="arch" type="xml">
            <tree string="Destinations" decoration-success="enabled" decoration-muted="not enabled">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="destination_type"/>
                <field name="zone" optional="show"/>
                <field name="enabled" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="action_print_gateway_destination" model="ir.actions.act_window">
        <field name="name">Destinations</field>
        <field name="res_model">print_gateway.destination</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>

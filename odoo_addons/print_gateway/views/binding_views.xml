<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_binding_list" model="ir.ui.view">
        <field name="name">print_gateway.binding.list</field>
        <field name="model">print_gateway.binding</field>
        <field name="arch" type="xml">
            <list string="Print Gateway Bindings" create="1" delete="1" class="o_pg_list">
                <field name="company_id" string="Odoo Company" optional="hide"/>
                <field name="branch_id" string="Odoo Branch" placeholder="All Branches / Root Default"/>
                <field name="effective_company_id" column_invisible="1"/>
                <field name="destination_type" string="Operational Area" widget="badge" decoration-info="destination_type == 'pos'" decoration-success="destination_type == 'report'" decoration-warning="destination_type == 'picking_type'"/>
                <field name="destination_ref" string="Odoo Destination"/>
                <field name="document_type" string="Document Type"/>
                <field name="runtime_agent_id" string="Gateway Runtime Agent" optional="show"/>
                <field name="printer_id" string="Gateway Runtime Printer"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="priority" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_print_gateway_binding_form" model="ir.ui.view">
        <field name="name">print_gateway.binding.form</field>
        <field name="model">print_gateway.binding</field>
        <field name="arch" type="xml">
            <form string="Print Gateway Binding">
                <header>
                    <button name="action_send_test_print" type="object" string="Send Test Page" class="btn btn-primary" icon="fa-print" invisible="not runtime_agent_id or not printer_id"/>
                    <button name="action_verify_remote_hardware" type="object" string="Validate Registration (Gateway)" class="btn btn-secondary" icon="fa-check-circle" invisible="not runtime_agent_id or not printer_id"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Print Binding</h1>
                        <p class="text-muted">Connect an Odoo document route to a Gateway printer.</p>
                    </div>

                    <separator string="Route"/>
                    <div class="mb-3">
                        <field name="name" readonly="1"/>
                    </div>
                    <div class="text-muted mb-3"><small>Odoo defines the business route. Gateway handles physical execution.</small></div>

                    <group string="Context">
                        <field name="company_id" string="Company" domain="[('parent_id', '=', False)]" options="{'no_create': True}"/>
                        <field name="branch_id" string="Branch" domain="[('parent_id', '=', company_id)]"
                               invisible="not company_id" placeholder="All Branches / Root Default" options="{'no_create': True}"/>
                    </group>

                    <group string="Destination">
                        <field name="destination_type" string="Destination Type" widget="radio" options="{'horizontal': true}"/>
                        <field name="destination_pos_config_id" string="Destination"
                               invisible="destination_type != 'pos'" required="destination_type == 'pos'"
                               domain="['&amp;', '|', ('company_id', '=', False), ('company_id', '=', effective_company_id), ('active', '=', True)]"/>
                        <field name="destination_pos_printer_id" string="Destination"
                               invisible="destination_type != 'pos_printer'" required="destination_type == 'pos_printer'"
                               domain="['|', ('company_id', '=', False), ('company_id', '=', effective_company_id)]"/>
                        <field name="destination_picking_type_id" string="Operation Type"
                               invisible="destination_type != 'picking_type'" required="destination_type == 'picking_type'"
                               domain="['&amp;', '|', ('company_id', '=', False), ('company_id', '=', effective_company_id), ('active', '=', True)]"/>
                        <field name="destination_report_id" string="Destination"
                               invisible="destination_type != 'report'" required="destination_type == 'report'"/>
                        <field name="report_id" string="Document / Report"
                               invisible="destination_type == 'pos_printer'" required="destination_type != 'pos_printer'"/>
                        <field name="document_type" string="Document Type" readonly="1"/>
                    </group>

                    <group string="Hardware">
                        <field name="runtime_agent_id" string="Runtime Agent" widget="gateway_runtime_agent"/>
                        <field name="printer_id" string="Runtime Printer" widget="gateway_runtime_printer"/>
                    </group>

                    <notebook>
                        <page string="Advanced Routing">
                            <group>
                                <field name="printer_protocol" string="Printer Protocol"/>
                                <field name="fallback_binding_id" string="Failover Backup Binding" options="{'no_create': True}"/>
                                <field name="enabled" widget="boolean_toggle"/>
                                <field name="priority"/>
                            </group>
                        </page>
                        <page string="Hardware Options">
                            <group>
                                <field name="drawer_kick_mode" string="Cash Drawer Kick"/>
                                <field name="cutter_mode" string="Paper Cutter"/>
                                <field name="buzzer_mode" string="Kitchen Chime"/>
                            </group>
                        </page>
                    </notebook>

                    <field name="effective_company_id" invisible="1"/>
                    <field name="destination_ref" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print_gateway_binding" model="ir.actions.act_window">
        <field name="name">Print Gateway Bindings</field>
        <field name="res_model">print_gateway.binding</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

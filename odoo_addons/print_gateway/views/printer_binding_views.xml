<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_printer_binding_form" model="ir.ui.view">
        <field name="name">print_gateway.printer_binding.form</field>
        <field name="model">print_gateway.printer_binding</field>
        <field name="arch" type="xml">
            <form string="Printer Binding" class="o_pg_view o_pg_form">
                <sheet>
                    <div class="o_pg_record_header">
                        <div class="o_pg_record_icon"><i class="fa fa-random" role="img" aria-label="Printer Binding"/></div>
                        <div>
                            <h1>Print Route</h1>
                            <div class="text-muted">Choose where this document type should print</div>
                        </div>
                        <div class="ms-auto"><field name="enabled" widget="boolean_toggle"/></div>
                    </div>
                    <group string="Route">
                        <field name="branch_id" options="{'no_create': True}"/>
                        <field name="destination_id" options="{'no_create': True}" domain="[('branch_id','=',branch_id)]"/>
                        <field name="document_type_id" options="{'no_create': True}" domain="[('branch_id','=',branch_id)]"/>
                        <field name="printer_id" options="{'no_create': True}" domain="[('branch_id','=',branch_id)]"/>
                    </group>
                    <group string="Notes"><field name="notes" placeholder="Optional notes for operators"/></group>
                    <notebook>
                        <page string="Advanced" name="advanced">
                            <group>
                                <field name="priority" help="Lower number is preferred when more than one printer matches."/>
                                <field name="document_type" placeholder="Fallback type when no Document Type is selected"/>
                                <field name="gateway_binding_id" readonly="1" class="o_pg_mono"/>
                                <field name="config_override" placeholder="Optional JSON override"/>
                            </group>
                        </page>
                    </notebook>
                    <div class="alert alert-info" role="alert">
                        Printing follows <b>Branch → Destination → Document Type → Printer</b>.
                        The printer and its agent are already synchronized from the Gateway; this screen only defines the route.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_print_gateway_printer_binding_tree" model="ir.ui.view">
        <field name="name">print_gateway.printer_binding.list</field>
        <field name="model">print_gateway.printer_binding</field>
        <field name="arch" type="xml">
            <list string="Print Routes" class="o_pg_view o_pg_list" decoration-success="enabled" decoration-muted="not enabled">
                <field name="branch_id"/>
                <field name="destination_id"/>
                <field name="document_type_id"/>
                <field name="printer_id"/>
                <field name="enabled" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_print_gateway_printer_binding" model="ir.actions.act_window">
        <field name="name">Print Routes</field>
        <field name="res_model">print_gateway.printer_binding</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No print routes configured yet.</p>
            <p>Choose a branch, destination, document type, and synchronized printer to define the route.</p>
        </field>
    </record>
</odoo>

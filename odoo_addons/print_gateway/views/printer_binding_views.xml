<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_printer_binding_form" model="ir.ui.view">
        <field name="name">print_gateway.printer_binding.form</field>
        <field name="model">print_gateway.printer_binding</field>
        <field name="arch" type="xml">
            <form string="Printer Binding" class="o_pg_view o_pg_form">
                <sheet>
                    <group string="Scope">
                        <field name="branch_id"/>
                        <field name="destination_id" domain="[('branch_id','=',branch_id)]"/>
                        <field name="document_type_id" domain="[('branch_id','=',branch_id)]"/>
                        <field name="document_type" placeholder="receipt / invoice / label / order (or leave empty for fallback)"/>
                    </group>
                    <group string="Target Printer">
                        <!-- Only printers whose AGENT is in this binding's branch are selectable:
                             printer -> agent -> branch is the only ownership path. -->
                        <field name="printer_id" domain="[('agent_id.branch_id','=',branch_id)]"
                               help="Printers of agents assigned to this branch."/>
                        <field name="priority" help="1 = highest. Fallback tries the next priority if the first printer is offline."/>
                        <field name="enabled" widget="boolean_toggle"/>
                    </group>
                    <group string="Gateway">
                        <field name="gateway_binding_id" readonly="1"/>
                        <field name="config_override" placeholder='{"copies": 2}' help="Optional JSON overrides merged into the default payload config for this binding."/>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        A binding routes <b>Branch → Destination → Document Type → Printer</b>. When several bindings match,
                        the lowest priority number wins; if that printer is offline, the next priority is tried.
                    </div>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_print_gateway_printer_binding_tree" model="ir.ui.view">
        <field name="name">print_gateway.printer_binding.tree</field>
        <field name="model">print_gateway.printer_binding</field>
        <field name="arch" type="xml">
            <tree string="Bindings" class="o_pg_view o_pg_list" decoration-success="enabled" decoration-muted="not enabled" decoration-bf="priority==1">
                <field name="branch_id"/>
                <field name="destination_id"/>
                <field name="document_type"/>
                <field name="printer_id"/>
                <field name="printer_agent_id" optional="hide"/>
                <field name="priority"/>
                <field name="enabled" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="action_print_gateway_printer_binding" model="ir.actions.act_window">
        <field name="name">Printer Bindings</field>
        <field name="res_model">print_gateway.printer_binding</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>

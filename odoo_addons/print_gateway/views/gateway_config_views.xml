<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_config_list" model="ir.ui.view">
        <field name="name">print_gateway.gateway_config.list</field>
        <field name="model">print_gateway.gateway_config</field>
        <field name="arch" type="xml">
            <list string="Gateway Configuration" create="1" delete="0">
                <field name="company_id" string="Odoo Company"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="gateway_url"/>
                <field name="last_test_status" widget="badge"/>
                <field name="last_test_at" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_print_gateway_config_form" model="ir.ui.view">
        <field name="name">print_gateway.gateway_config.form</field>
        <field name="model">print_gateway.gateway_config</field>
        <field name="arch" type="xml">
            <form string="Gateway Configuration" create="1" delete="0">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="oe_highlight"/>
                    <button name="action_open_pairing_wizard" type="object" string="Pair New Agent" class="btn-primary" icon="fa-link"/>
                </header>
                <sheet>
                    <h2>Print Gateway</h2>
                    <p class="text-muted">Odoo owns business context and print intent. Gateway owns runtime Agents, runtime Printers, queueing and execution.</p>
                    <div class="alert alert-danger" role="alert" invisible="last_test_status != 'revoked'">
                        The installation API key was revoked or deleted on the Gateway, and printing has been disabled. Paste a new key or press Clear / Remove Key, then test the connection again.
                    </div>
                    <group>
                        <field name="company_id" string="Odoo Company"/>
                        <field name="enabled" widget="boolean_toggle"/>
                    </group>
                    <group string="Connection">
                        <field name="gateway_url" placeholder="https://print.example.com"/>
                        <field name="gateway_api_key" password="True" placeholder="Paste the installation API key"/>
                        <button name="action_clear_api_key" type="object" string="Clear / Remove Key" class="btn btn-outline-danger btn-sm" groups="base.group_system" invisible="not gateway_api_key"/>
                    </group>
                    <group string="Connection Test" col="4">
                        <field name="last_test_status" readonly="1" widget="badge" decoration-success="last_test_status == 'success'" decoration-danger="last_test_status in ('failed', 'revoked')"/>
                        <field name="last_test_at" readonly="1"/>
                        <field name="last_test_error" readonly="1" invisible="not last_test_error" colspan="2"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print_gateway_config" model="ir.actions.act_window">
        <field name="name">Gateway Configuration</field>
        <field name="res_model">print_gateway.gateway_config</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_print_gateway_pair_agent_wizard_form" model="ir.ui.view">
        <field name="name">print_gateway.pair_agent_wizard.form</field>
        <field name="model">print_gateway.pair_agent_wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Runtime Agent" class="o_pg_pairing_wizard">
                <sheet>
                    <div class="o_pg_wizard_header text-center mb-4">
                        <i class="fa fa-plug fa-3x text-primary mb-2" title="Assign Agent" role="img" aria-label="Assign Agent"/>
                        <h3 class="fw-bold">Assign Hardware Print Agent</h3>
                        <p class="text-muted">Enter the Agent ID or name of an active agent registered on the Central Gateway to bind it to a branch.</p>
                    </div>
                    <group>
                        <field name="config_id" invisible="1"/>
                        <field name="company_id" invisible="1"/>
                        <field name="branch_id" string="Target Branch" options="{'no_create': True, 'no_open': True}"/>
                        <field name="agent_id" placeholder="e.g. agent-pos-01" class="o_pg_pairing_code_input text-center fw-bold fs-4"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_pairing" string="Assign Agent" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_job_list" model="ir.ui.view">
        <field name="name">print_gateway.print_job.list</field>
        <field name="model">print_gateway.print_job</field>
        <field name="arch" type="xml">
            <list string="Print Jobs" create="0" delete="0">
                <field name="create_date"/>
                <field name="company_id" optional="hide"/>
                <field name="document_type"/>
                <field name="destination"/>
                <field name="printer_id"/>
                <field name="status" widget="badge"/>
                <field name="physical_outcome" widget="badge"/>
                <field name="attempts" optional="show"/>
                <field name="gateway_job_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_print_gateway_job_form" model="ir.ui.view">
        <field name="name">print_gateway.print_job.form</field>
        <field name="model">print_gateway.print_job</field>
        <field name="arch" type="xml">
            <form string="Print Job" create="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Retry" class="oe_highlight" invisible="status != 'failed' or physical_outcome != 'not_printed'"/>
                    <button name="action_sync_status" type="object" string="Refresh Status" invisible="not gateway_job_id"/>
                </header>
                <sheet>
                    <group>
                        <field name="company_id" readonly="1"/>
                        <field name="document_type" readonly="1"/>
                        <field name="destination" readonly="1"/>
                        <field name="printer_id" readonly="1"/>
                        <field name="status" readonly="1" widget="badge"/>
                        <field name="physical_outcome" readonly="1" widget="badge"/>
                    </group>
                    <group string="Gateway">
                        <field name="gateway_job_id" readonly="1"/>
                        <field name="idempotency_key" readonly="1"/>
                        <field name="attempts" readonly="1"/>
                        <field name="next_retry_at" readonly="1"/>
                        <field name="last_error" readonly="1" invisible="not last_error"/>
                    </group>
                    <group string="Source">
                        <field name="source_model" readonly="1"/>
                        <field name="source_record_id" readonly="1"/>
                        <field name="report_id" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_print_gateway_jobs" model="ir.actions.act_window">
        <field name="name">Print Jobs</field>
        <field name="res_model">print_gateway.print_job</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

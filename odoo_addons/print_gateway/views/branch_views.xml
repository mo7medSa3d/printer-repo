<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_branch_form" model="ir.ui.view">
        <field name="name">print_gateway.branch.form</field>
        <field name="model">print_gateway.branch</field>
        <field name="arch" type="xml">
            <form string="Odoo Branch Print Configuration" class="o_pg_view o_pg_form" create="0" delete="0">
                <header>
                    <button name="action_refresh_from_odoo" type="object" string="Refresh From Odoo" class="oe_highlight"/>
                    <button name="action_test_connection" type="object" string="Test Gateway"/>
                    <button name="action_sync_from_gateway" type="object" string="Sync Runtime From Gateway"/>
                    <button name="action_sync_to_gateway" type="object" string="Sync Config To Gateway"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">
                        <b>Odoo owns the branch.</b> This record is only Print Gateway configuration for an existing Odoo company/branch.
                        Create or rename the branch from Odoo's Companies/Branches settings, then use <b>Refresh From Odoo</b>.
                    </div>
                    <group string="Odoo Identity">
                        <field name="company_id" readonly="1"/>
                        <field name="name" readonly="1"/>
                        <field name="location" placeholder="Optional print location"/>
                        <field name="timezone" placeholder="e.g., Africa/Cairo"/>
                        <field name="enabled" widget="boolean_toggle"/>
                        <field name="gateway_branch_id" readonly="1"/>
                    </group>
                    <group string="Gateway Connection">
                        <field name="gateway_url" placeholder="https://print.example.com" help="Base URL of the Print Gateway, without trailing slash."/>
                        <field name="gateway_api_key" password="True" placeholder="odoo_..." help="Gateway credential used by this Odoo configuration. Keep it secret."/>
                        <field name="last_sync_at" readonly="1"/>
                        <field name="last_sync_status" readonly="1"/>
                        <field name="last_successful_sync_at" readonly="1"/>
                        <field name="last_sync_error" readonly="1" invisible="last_sync_status != 'failed'"/>
                    </group>
                    <notebook>
                        <page string="Destinations" name="destinations">
                            <field name="destination_ids"/>
                        </page>
                        <page string="Printers" name="printers">
                            <field name="printer_ids"/>
                        </page>
                        <page string="Agents" name="agents">
                            <field name="agent_ids"/>
                        </page>
                        <page string="Bindings" name="bindings">
                            <field name="binding_ids"/>
                        </page>
                    </notebook>
                    <group string="Runtime Summary">
                        <field name="agent_count" readonly="1"/>
                        <field name="printer_count" readonly="1"/>
                    </group>
                    <group string="Print Gateway Configuration">
                        <field name="description" placeholder="Optional notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_print_gateway_branch_tree" model="ir.ui.view">
        <field name="name">print_gateway.branch.list</field>
        <field name="model">print_gateway.branch</field>
        <field name="arch" type="xml">
            <list string="Odoo Branch Print Configurations" class="o_pg_view o_pg_list" create="0" delete="0" decoration-success="enabled" decoration-muted="not enabled">
                <field name="name"/>
                <field name="company_id"/>
                <field name="gateway_branch_id" optional="show"/>
                <field name="gateway_url"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="agent_count"/>
                <field name="printer_count"/>
                <field name="last_sync_at" optional="show"/>
                <field name="last_sync_status" optional="show"/>
            </list>
        </field>
    </record>

    <record id="action_print_gateway_branch" model="ir.actions.act_window">
        <field name="name">Odoo Branch Print Configurations</field>
        <field name="res_model">print_gateway.branch</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>
</odoo>

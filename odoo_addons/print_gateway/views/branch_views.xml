<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_branch_form" model="ir.ui.view">
        <field name="name">print_gateway.branch.form</field>
        <field name="model">print_gateway.branch</field>
        <field name="arch" type="xml">
            <form string="Branch Print Configuration" class="o_pg_view o_pg_form" create="0" delete="0">
                <header>
                    <button name="action_refresh_from_odoo" type="object" string="Refresh From Odoo" class="oe_highlight"/>
                    <button name="action_test_connection" type="object" string="Test Gateway"/>
                    <button name="action_sync_from_gateway" type="object" string="Sync Runtime"/>
                    <button name="action_sync_to_gateway" type="object" string="Sync Configuration"/>
                </header>
                <sheet>
                    <div class="o_pg_record_header">
                        <div class="o_pg_record_icon"><i class="fa fa-building" role="img" aria-label="Branch"/></div>
                        <div>
                            <h1><field name="name" readonly="1"/></h1>
                            <div class="text-muted">Print Gateway configuration for an existing Odoo branch</div>
                        </div>
                        <div class="ms-auto"><field name="enabled" widget="boolean_toggle"/></div>
                    </div>
                    <div class="alert alert-info" role="alert">
                        <b>Odoo owns the branch.</b> Create, rename, or reorganize branches from Odoo Companies/Branches.
                        This screen only configures printing for that existing branch.
                    </div>
                    <group string="Gateway Connection">
                        <field name="company_id" readonly="1" options="{'no_create': True}"/>
                        <field name="gateway_url" placeholder="http://127.0.0.1:3000 or https://print.example.com"/>
                        <field name="gateway_api_key" password="True" placeholder="Enter gateway key"/>
                    </group>
                    <group string="Optional Branch Details">
                        <field name="location" placeholder="Optional location label"/>
                        <field name="timezone" placeholder="Optional timezone"/>
                        <field name="description" placeholder="Optional notes"/>
                    </group>
                    <notebook>
                        <page string="Runtime">
                            <group>
                                <field name="agent_count" readonly="1"/>
                                <field name="printer_count" readonly="1"/>
                                <field name="last_sync_status" readonly="1" widget="badge"/>
                                <field name="last_successful_sync_at" readonly="1"/>
                            </group>
                        </page>
                        <page string="Printers"><field name="printer_ids" readonly="1"/></page>
                        <page string="Agents"><field name="agent_ids" readonly="1"/></page>
                        <page string="Destinations"><field name="destination_ids"/></page>
                        <page string="Routes"><field name="binding_ids"/></page>
                        <page string="Technical" name="technical">
                            <group>
                                <field name="gateway_branch_id" readonly="1" class="o_pg_mono"/>
                                <field name="last_sync_at" readonly="1"/>
                                <field name="last_sync_error" readonly="1" invisible="last_sync_status != 'failed'"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_print_gateway_branch_tree" model="ir.ui.view">
        <field name="name">print_gateway.branch.list</field>
        <field name="model">print_gateway.branch</field>
        <field name="arch" type="xml">
            <list string="Branch Print Configuration" class="o_pg_view o_pg_list" create="0" delete="0" decoration-success="enabled" decoration-muted="not enabled">
                <field name="name"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="agent_count"/>
                <field name="printer_count"/>
                <field name="last_sync_status" widget="badge"/>
                <field name="last_successful_sync_at" optional="show"/>
            </list>
        </field>
    </record>
    <record id="action_print_gateway_branch" model="ir.actions.act_window">
        <field name="name">Branch Print Configuration</field>
        <field name="res_model">print_gateway.branch</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'create': False, 'delete': False}</field>
    </record>
</odoo>

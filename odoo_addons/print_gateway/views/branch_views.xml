<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_branch_form" model="ir.ui.view">
        <field name="name">print_gateway.branch.form</field>
        <field name="model">print_gateway.branch</field>
        <field name="arch" type="xml">
            <form string="Print Branch" class="o_pg_view o_pg_form">
                <header>
                    <button name="action_test_connection" type="object" string="Test Connection" class="oe_highlight"/>
                    <button name="action_sync_from_gateway" type="object" string="Sync From Gateway"/>
                    <button name="action_sync_to_gateway" type="object" string="Sync To Gateway"/>
                </header>
                <sheet>
                    <group string="Identity">
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="location" placeholder="e.g., Cairo Downtown"/>
                        <field name="timezone" placeholder="e.g., Africa/Cairo"/>
                        <field name="enabled" widget="boolean_toggle"/>
                    </group>
                    <group string="Gateway Connection">
                        <field name="gateway_url" placeholder="https://print.example.com" help="Base URL of the Print Gateway, without trailing slash."/>
                        <field name="gateway_api_key" password="True" placeholder="odoo_..." help="Scoped Odoo API key configured in the Gateway. Stored and sent only to the gateway URL above."/>
                        <field name="gateway_branch_id" help="Branch identifier as known to the Gateway, e.g. branch_cairo_01."/>
                        <field name="last_sync_at" readonly="1" help="Last successful synchronization with the Gateway."/>
                    </group>
                    <notebook>
                        <page string="Destinations" name="destinations">
                            <field name="destination_ids"/>
                        </page>
                        <page string="Printers" name="printers">
                            <field name="printer_ids"/>
                        </page>
                        <page string="Agents" name="agents">
                            <field name="agent_ids"/>
                        </page>
                        <page string="Bindings" name="bindings">
                            <field name="binding_ids"/>
                        </page>
                    </notebook>
                    <group string="Summary">
                        <field name="agent_count" readonly="1"/>
                        <field name="printer_count" readonly="1"/>
                    </group>
                    <div class="alert alert-info" role="alert">
                        <b>Directions:</b> Destinations, document types, printer bindings and agents all belong to a branch.
                        The Gateway is the source of truth for printers, agents and jobs; Odoo owns routing preferences
                        (destination + document type + binding priority) and pushes them to the Gateway.
                    </div>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_print_gateway_branch_tree" model="ir.ui.view">
        <field name="name">print_gateway.branch.tree</field>
        <field name="model">print_gateway.branch</field>
        <field name="arch" type="xml">
            <tree string="Branches" class="o_pg_view o_pg_list" decoration-success="enabled" decoration-muted="not enabled">
                <field name="name"/>
                <field name="gateway_url"/>
                <field name="enabled" widget="boolean_toggle"/>
                <field name="agent_count"/>
                <field name="printer_count"/>
                <field name="last_sync_at" optional="show"/>
            </tree>
        </field>
    </record>

    <record id="action_print_gateway_branch" model="ir.actions.act_window">
        <field name="name">Print Branches</field>
        <field name="res_model">print_gateway.branch</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>

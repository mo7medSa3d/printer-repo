<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Default Odoo QWeb PDF report mappings. Admins can disable or replace these. -->
    <!-- report_xml_id is used as a hint; runtime also supports report_name/model fallback. -->

    <record id="report_mapping_sale_order" model="print_gateway.report_mapping">
        <field name="report_xml_id">sale.action_report_saleorder</field>
        <field name="report_name">sale.report_saleorder</field>
        <field name="model_name">sale.order</field>
        <field name="document_type_name">order</field>
        <field name="gateway_enabled">True</field>
        <field name="priority">10</field>
        <field name="active">True</field>
    </record>

    <record id="report_mapping_sale_quotation" model="print_gateway.report_mapping">
        <field name="report_xml_id">sale.action_report_saleorder</field>
        <field name="report_name">sale.report_saleorder</field>
        <field name="model_name">sale.order</field>
        <field name="document_type_name">quotation</field>
        <field name="gateway_enabled">True</field>
        <field name="priority">20</field>
        <field name="active">False</field>
    </record>

    <record id="report_mapping_invoice" model="print_gateway.report_mapping">
        <field name="report_xml_id">account.action_report_invoice</field>
        <field name="report_name">account.report_invoice_with_payments</field>
        <field name="model_name">account.move</field>
        <field name="document_type_name">invoice</field>
        <field name="gateway_enabled">True</field>
        <field name="priority">10</field>
        <field name="active">True</field>
    </record>

    <record id="report_mapping_delivery" model="print_gateway.report_mapping">
        <field name="report_xml_id">stock.action_report_delivery</field>
        <field name="report_name">stock.report_deliveryslip</field>
        <field name="model_name">stock.picking</field>
        <field name="document_type_name">delivery</field>
        <field name="gateway_enabled">True</field>
        <field name="priority">10</field>
        <field name="active">True</field>
    </record>

    <record id="report_mapping_picking" model="print_gateway.report_mapping">
        <field name="report_xml_id">stock.action_report_picking</field>
        <field name="report_name">stock.report_picking</field>
        <field name="model_name">stock.picking</field>
        <field name="document_type_name">picking</field>
        <field name="gateway_enabled">True</field>
        <field name="priority">20</field>
        <field name="active">True</field>
    </record>

    <record id="report_mapping_purchase" model="print_gateway.report_mapping">
        <field name="report_xml_id">purchase.action_report_purchase_order</field>
        <field name="report_name">purchase.report_purchaseorder</field>
        <field name="model_name">purchase.order</field>
        <field name="document_type_name">purchase_order</field>
        <field name="gateway_enabled">True</field>
        <field name="priority">10</field>
        <field name="active">True</field>
    </record>

    <record id="report_mapping_pos_receipt" model="print_gateway.report_mapping">
        <field name="report_xml_id">point_of_sale.action_report_receipt</field>
        <field name="report_name">point_of_sale.report_receipt</field>
        <field name="model_name">pos.order</field>
        <field name="document_type_name">receipt</field>
        <field name="gateway_enabled">True</field>
        <field name="priority">10</field>
        <field name="active">True</field>
    </record>

    <!-- Raw ESC/POS is intentionally not configured as a QWeb report mapping.
         Use the direct print-job APIs for already-formatted ESC/POS payloads. -->
</odoo>

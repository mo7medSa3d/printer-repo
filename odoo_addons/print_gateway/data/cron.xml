<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="cron_submit_pending_gateway_print_jobs" model="ir.cron">
        <field name="name">Print Gateway: Submit Pending Print Jobs</field>
        <field name="model_id" ref="model_print_gateway_print_job"/>
        <field name="state">code</field>
        <field name="code">model.cron_submit_pending()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="cron_sync_gateway_print_jobs" model="ir.cron">
        <field name="name">Print Gateway: Reconcile Print Jobs</field>
        <field name="model_id" ref="model_print_gateway_print_job"/>
        <field name="state">code</field>
        <field name="code">model.cron_sync_status()</field>
        <field name="interval_number">2</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>

    <record id="cron_recover_pending_gateway_intents" model="ir.cron">
        <field name="name">Print Gateway: Recover Pending Print Intents</field>
        <field name="model_id" ref="model_print_gateway_intent"/>
        <field name="state">code</field>
        <field name="code">model.cron_recover_pending_intents()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active">True</field>
    </record>
</odoo>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Row-level security rules for branch/company isolation -->
    <!-- CRITICAL: Enforce company isolation on all branch-scoped models -->
    
    <!-- Branch: Users can only access branches in their company -->
    <record id="rule_branch_company_isolation" model="ir.rule">
        <field name="name">Branch company isolation</field>
        <field name="model_id" ref="model_print_gateway_branch"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('company_id', '=', user.company_id.id)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <!-- Destination: Must belong to a branch in user's company -->
    <record id="rule_destination_branch_company" model="ir.rule">
        <field name="name">Destination branch company isolation</field>
        <field name="model_id" ref="model_print_gateway_destination"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('branch_id.company_id', '=', user.company_id.id)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <!-- Document Type: Must belong to a branch in user's company -->
    <record id="rule_document_type_branch_company" model="ir.rule">
        <field name="name">Document type branch company isolation</field>
        <field name="model_id" ref="model_print_gateway_document_type"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('branch_id.company_id', '=', user.company_id.id)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <!-- Printer: Must belong to a branch in user's company -->
    <record id="rule_printer_branch_company" model="ir.rule">
        <field name="name">Printer branch company isolation</field>
        <field name="model_id" ref="model_print_gateway_printer"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('branch_id.company_id', '=', user.company_id.id)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Printer Binding: Must belong to a branch in user's company, and write restricted to managers -->
    <record id="rule_printer_binding_branch_company" model="ir.rule">
        <field name="name">Printer binding branch company isolation</field>
        <field name="model_id" ref="model_print_gateway_printer_binding"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('branch_id.company_id', '=', user.company_id.id)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Printer Binding write: Only system users (managers) can modify bindings -->
    <record id="rule_printer_binding_write_system_only" model="ir.rule">
        <field name="name">Printer binding write system only</field>
        <field name="model_id" ref="model_print_gateway_printer_binding"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <!-- Agent: Must belong to a branch in user's company, read-only for users -->
    <record id="rule_agent_branch_company" model="ir.rule">
        <field name="name">Agent branch company isolation</field>
        <field name="model_id" ref="model_print_gateway_agent"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('branch_id.company_id', '=', user.company_id.id)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Print Job: Must belong to a branch in user's company, read-only for users -->
    <record id="rule_print_job_branch_company" model="ir.rule">
        <field name="name">Print job branch company isolation</field>
        <field name="model_id" ref="model_print_gateway_print_job"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('branch_id.company_id', '=', user.company_id.id)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>

    <!-- Report Mapping: Only system users, with company isolation -->
    <record id="rule_report_mapping_branch_company" model="ir.rule">
        <field name="name">Report mapping branch company isolation</field>
        <field name="model_id" ref="model_print_gateway_report_mapping"/>
        <field name="groups" eval="[(4, ref('base.group_system'))]"/>
        <field name="domain_force">[('branch_id.company_id', '=', user.company_id.id)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">1</field>
        <field name="perm_create">1</field>
        <field name="perm_unlink">1</field>
    </record>

    <!-- Report Mapping read-only for regular users -->
    <record id="rule_report_mapping_user_readonly" model="ir.rule">
        <field name="name">Report mapping user read-only</field>
        <field name="model_id" ref="model_print_gateway_report_mapping"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('branch_id.company_id', '=', user.company_id.id)]</field>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>

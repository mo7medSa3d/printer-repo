<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_gateway_config_company" model="ir.rule">
        <field name="name">Gateway configuration company isolation</field>
        <field name="model_id" ref="model_print_gateway_gateway_config"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('company_id.child_ids', 'in', company_ids)]</field>
    </record>

    <record id="rule_runtime_assignment_company" model="ir.rule">
        <field name="name">Runtime agent assignment company isolation</field>
        <field name="model_id" ref="model_print_gateway_runtime_agent_assignment"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('branch_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_binding_company" model="ir.rule">
        <field name="name">Print binding company isolation</field>
        <field name="model_id" ref="model_print_gateway_binding"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('branch_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_print_job_company" model="ir.rule">
        <field name="name">Print job company isolation</field>
        <field name="model_id" ref="model_print_gateway_print_job"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_print_policy_company" model="ir.rule">
        <field name="name">Print policy company isolation</field>
        <field name="model_id" ref="model_print_gateway_policy"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('company_id', 'in', company_ids), ('branch_id', 'in', company_ids)]</field>
    </record>

    <record id="rule_print_intent_company" model="ir.rule">
        <field name="name">Print intent company isolation</field>
        <field name="model_id" ref="model_print_gateway_intent"/>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_print_gateway_document_type_form" model="ir.ui.view">
        <field name="name">print_gateway.document_type.form</field>
        <field name="model">print_gateway.document_type</field>
        <field name="arch" type="xml">
            <form string="Document Type" class="o_pg_view o_pg_form">
                <sheet>
                    <group string="Identity">
                        <field name="name" placeholder="receipt, invoice, label, order" help="Lowercase logical type, e.g. receipt, invoice, label, order."/>
                        <field name="branch_id"/>
                        <field name="enabled" widget="boolean_toggle"/>
                    </group>
                    <group string="Routing Hint">
                        <field name="payload_hint" placeholder="e.g., 80mm thermal, auto-cut, 2 copies" help="Optional human-readable hint shown to operators; routing still uses bindings below."/>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_print_gateway_document_type_tree" model="ir.ui.view">
        <field name="name">print_gateway.document_type.tree</field>
        <field name="model">print_gateway.document_type</field>
        <field name="arch" type="xml">
            <tree string="Document Types" class="o_pg_view o_pg_list" decoration-success="enabled" decoration-muted="not enabled">
                <field name="name"/>
                <field name="branch_id"/>
                <field name="payload_hint"/>
                <field name="enabled" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>
    <record id="action_print_gateway_document_type" model="ir.actions.act_window">
        <field name="name">Document Types</field>
        <field name="res_model">print_gateway.document_type</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>

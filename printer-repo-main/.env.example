# ─── Odoo Print Gateway — environment ────────────────────────────────────────
# Copy to `.env` for local development. In production, inject these via your
# process manager / secrets store — never commit a real `.env`.

# PostgreSQL connection for the gateway (job queue, agents, printers, keys).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# HMAC secret for manager session JWTs. REQUIRED in production, >= 32 chars.
# Generate: openssl rand -hex 32
GATEWAY_JWT_SECRET=changeme-to-at-least-32-chars-random-string

# Manager dashboard credentials. Use the scrypt hash (salt:derived-hex) in
# production so the plaintext never lives on disk:
#   node -e "const{crypto}=require('crypto');const s=crypto.randomBytes(8).toString('hex');console.log(s+':'+crypto.scryptSync(process.argv[1],s,32).toString('hex'))" yourpass
MANAGER_USERNAME=admin
MANAGER_PASSWORD=changeme
# MANAGER_PASSWORD_HASH=abc123:deadbeef...

# HTTP listener (server.ts also binds the Agent WebSocket on /api/agent/ws).
PORT=3000
HOSTNAME=0.0.0.0

NODE_ENV=development

# Set to 1 when the gateway sits behind a reverse proxy that sets
# X-Forwarded-For / X-Real-Ip. Required for per-IP auth rate limiting to
# see the client address instead of the proxy.
# TRUST_PROXY=1

# ─── Windows desktop/agent overrides (set on the CLIENT PC, not the gateway) ─
# ODOO_PRINT_MANAGER_DATA_DIR=C:\ProgramData\OdooPrintManager
# ODOO_PRINT_AGENT_DATA_DIR=C:\ProgramData\OdooPrintAgent

# Agent freshness policy for job routing (10..3600 seconds; default 90).
STALE_AGENT_THRESHOLD_SECONDS=90
